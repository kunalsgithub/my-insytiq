# Copy to .env and .env.<projectId> (do not commit). Loaded by Firebase CLI on deploy/emulator.
#
# Names use CFG_ prefix so Cloud Run does not conflict with legacy Secret Manager env vars
# (same key as both "secret ref" and plain env causes deploy 400 overlap errors).
CFG_OPENAI_API_KEY=
CFG_SB_CLIENT_ID=
CFG_SB_API_TOKEN=
CFG_APIFY_API_TOKEN=
# Trending Explore sync only (reels + carousels) — separate Apify account/billing
CFG_APIFY_TRENDING_API_TOKEN=
CFG_TRENDING_MAX_RESULTS=200
CFG_TRENDING_DOWNLOAD_MEDIAS=none
CFG_TRENDING_COUNTRY=India
CFG_PADDLE_WEBHOOK_SECRET=
CFG_SENDGRID_API_KEY=
CFG_CREATOR_ADMIN_EMAIL=official@insytiq.ai
